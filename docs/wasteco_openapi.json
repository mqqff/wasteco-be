{
  "openapi": "3.1.0",
  "info": {
    "title": "WasteCo Backend API",
    "description": "RESTful API backend for WasteCo - Household Food Waste Prevention & Management System.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8000",
      "description": "Local Development Server"
    }
  ],
  "components": {
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "x-api-key",
        "description": "Required API key for public and protected routes"
      },
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "JWT Bearer token from login/registration"
      }
    }
  },
  "security": [
    {
      "ApiKeyAuth": []
    }
  ],
  "paths": {
    "/api/v1/auth/register": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Register New User Account",
        "description": "Create a new user account with email, password, and area information.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "example": {
                "name": "Affan Maulana",
                "email": "affan@wasteco.id",
                "password": "password123",
                "phone_number": "+6281234567890",
                "area_name": "Dinoyo, Lowokwaru, Malang",
                "latitude": -7.9528,
                "longitude": 112.6074,
                "sharing_radius_km": 3
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "User account created successfully and JWT token returned"
          }
        }
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "User Login",
        "description": "Authenticate user with email and password to receive a JWT access token.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "example": {
                "email": "affan@wasteco.id",
                "password": "password123"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login successful"
          }
        }
      }
    },
    "/api/v1/me": {
      "get": {
        "tags": [
          "User Profile"
        ],
        "summary": "Get Profile & Contribution Summary",
        "description": "Retrieve current authenticated user profile along with aggregated food portions and money saved.",
        "security": [
          {
            "ApiKeyAuth": []
          },
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "User profile with contribution statistics"
          }
        }
      },
      "put": {
        "tags": [
          "User Profile"
        ],
        "summary": "Update User Profile",
        "description": "Update user profile details such as name, phone number, neighborhood area, coordinates, and donation sharing radius.",
        "security": [
          {
            "ApiKeyAuth": []
          },
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "example": {
                "name": "Affan Maulana",
                "phone_number": "+6281234567890",
                "area_name": "Dinoyo, Lowokwaru, Malang",
                "latitude": -7.9528,
                "longitude": 112.6074,
                "sharing_radius_km": 3
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Profile updated successfully"
          }
        }
      }
    },
    "/api/v1/pantry": {
      "get": {
        "tags": [
          "Pantry"
        ],
        "summary": "List Active Pantry Ingredients",
        "description": "Retrieve active kitchen inventory items for the authenticated user.",
        "security": [
          {
            "ApiKeyAuth": []
          },
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "category",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Filter by ingredient category"
          },
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Filter by status: fresh, near_expiry"
          }
        ],
        "responses": {
          "200": {
            "description": "List of active pantry ingredients"
          }
        }
      },
      "post": {
        "tags": [
          "Pantry"
        ],
        "summary": "Add Pantry Ingredient",
        "description": "Add a new ingredient item to the user's pantry inventory.",
        "security": [
          {
            "ApiKeyAuth": []
          },
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "example": {
                "name": "Fresh Carrot",
                "quantity": 250,
                "unit": "gram",
                "category": "Vegetables",
                "storage_location": "Crisper drawer",
                "expiry_date": "2026-11-15",
                "estimated_price": 5000
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Pantry ingredient created successfully"
          }
        }
      }
    },
    "/api/v1/pantry/{id}": {
      "put": {
        "tags": [
          "Pantry"
        ],
        "summary": "Update Pantry Ingredient",
        "description": "Update details, quantity, status, or expiry date of an ingredient.",
        "security": [
          {
            "ApiKeyAuth": []
          },
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "example": {
                "name": "Fresh Carrot",
                "quantity": 200,
                "unit": "gram",
                "category": "Vegetables",
                "storage_location": "Crisper drawer",
                "expiry_date": "2026-11-15",
                "status": "near_expiry",
                "estimated_price": 4000
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Pantry ingredient updated successfully"
          }
        }
      },
      "delete": {
        "tags": [
          "Pantry"
        ],
        "summary": "Delete Pantry Ingredient",
        "description": "Remove an ingredient from the user's pantry.",
        "security": [
          {
            "ApiKeyAuth": []
          },
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Pantry ingredient deleted successfully"
          }
        }
      }
    },
    "/api/v1/recipes/generate": {
      "post": {
        "tags": [
          "Recipes & AI"
        ],
        "summary": "Generate Zero-Waste Recipes (Gemini AI)",
        "description": "Submit available ingredients to Gemini AI to generate customized zero-waste recipes ranked by match percentage.",
        "security": [
          {
            "ApiKeyAuth": []
          },
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "example": {
                "ingredient_ids": [
                  "258568e6-4c01-4968-bdaa-8db09af7c40b",
                  "fbc6bf3d-6155-4332-9e62-7ff1d2a36790"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "List of recommended recipes from Gemini AI"
          }
        }
      }
    },
    "/api/v1/recipes/cook-confirm": {
      "post": {
        "tags": [
          "Recipes & AI"
        ],
        "summary": "Confirm Cooking & Auto-Deduct Pantry",
        "description": "Confirm recipe completion, deduct used pantry quantities, and log saved portions and cost to impact analytics.",
        "security": [
          {
            "ApiKeyAuth": []
          },
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "example": {
                "recipe_name": "Vegetable Fried Rice",
                "portions": 2,
                "estimated_savings": 25000,
                "used_ingredients": [
                  {
                    "ingredient_id": "fbc6bf3d-6155-4332-9e62-7ff1d2a36790",
                    "name": "White Rice",
                    "quantity": 1,
                    "unit": "portion",
                    "estimated_price": 5000
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Pantry deducted and cooking impact recorded successfully"
          }
        }
      }
    },
    "/api/v1/donations": {
      "get": {
        "tags": [
          "Donations"
        ],
        "summary": "Explore Nearby Food Donations",
        "description": "Explore active surplus food donations with real-time Haversine distance calculations and location filtering.",
        "parameters": [
          {
            "name": "lat",
            "in": "query",
            "schema": {
              "type": "number"
            },
            "example": -7.9535,
            "description": "User latitude"
          },
          {
            "name": "long",
            "in": "query",
            "schema": {
              "type": "number"
            },
            "example": 112.608,
            "description": "User longitude"
          },
          {
            "name": "radius",
            "in": "query",
            "schema": {
              "type": "number"
            },
            "example": 5,
            "description": "Search radius in km"
          },
          {
            "name": "category",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "example": "Vegetables",
            "description": "Filter by category"
          },
          {
            "name": "search",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "example": "carrot",
            "description": "Search keyword"
          }
        ],
        "responses": {
          "200": {
            "description": "List of available donations with distance"
          }
        }
      },
      "post": {
        "tags": [
          "Donations"
        ],
        "summary": "Post Food Donation",
        "description": "Post surplus food with photo uploads, condition notes, pickup deadline, meeting point, and WhatsApp contact.",
        "security": [
          {
            "ApiKeyAuth": []
          },
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string",
                    "example": "Fresh Garden Carrots"
                  },
                  "category": {
                    "type": "string",
                    "example": "Vegetables"
                  },
                  "quantity": {
                    "type": "number",
                    "example": 500
                  },
                  "unit": {
                    "type": "string",
                    "example": "gram"
                  },
                  "condition_note": {
                    "type": "string",
                    "example": "Washed clean, crisp and fresh"
                  },
                  "storage_method": {
                    "type": "string",
                    "example": "Chiller in airtight container"
                  },
                  "pickup_deadline": {
                    "type": "string",
                    "example": "2026-11-13T18:00:00Z"
                  },
                  "area_name": {
                    "type": "string",
                    "example": "Dinoyo, Malang"
                  },
                  "meeting_point": {
                    "type": "string",
                    "example": "In front of Alfamart MT Haryono"
                  },
                  "latitude": {
                    "type": "number",
                    "example": -7.9535
                  },
                  "longitude": {
                    "type": "number",
                    "example": 112.608
                  },
                  "whatsapp_number": {
                    "type": "string",
                    "example": "+6281358902144"
                  },
                  "estimated_price": {
                    "type": "number",
                    "example": 10000
                  },
                  "estimated_portions": {
                    "type": "integer",
                    "example": 2
                  },
                  "photos": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "format": "binary"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Food donation published successfully"
          }
        }
      }
    },
    "/api/v1/donations/my": {
      "get": {
        "tags": [
          "Donations"
        ],
        "summary": "Get My Posted Donations",
        "description": "Retrieve user's posted donations split into active and history tabs.",
        "security": [
          {
            "ApiKeyAuth": []
          },
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "User's donations list"
          }
        }
      }
    },
    "/api/v1/donations/{id}": {
      "get": {
        "tags": [
          "Donations"
        ],
        "summary": "Get Donation Detail & Contact",
        "description": "Retrieve complete donation details, donor information, and WhatsApp coordination contact.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "lat",
            "in": "query",
            "schema": {
              "type": "number"
            },
            "description": "Optional user latitude for distance"
          },
          {
            "name": "long",
            "in": "query",
            "schema": {
              "type": "number"
            },
            "description": "Optional user longitude for distance"
          }
        ],
        "responses": {
          "200": {
            "description": "Donation detail and donor info"
          }
        }
      },
      "delete": {
        "tags": [
          "Donations"
        ],
        "summary": "Cancel Donation",
        "description": "Cancel a posted food donation.",
        "security": [
          {
            "ApiKeyAuth": []
          },
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Donation cancelled successfully"
          }
        }
      }
    },
    "/api/v1/donations/{id}/status": {
      "patch": {
        "tags": [
          "Donations"
        ],
        "summary": "Update Donation Status",
        "description": "Update the status of a donation (e.g. in_progress, available, completed, cancelled).",
        "security": [
          {
            "ApiKeyAuth": []
          },
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "example": {
                "status": "in_progress"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Donation status updated"
          }
        }
      }
    },
    "/api/v1/donations/{id}/confirm-handed": {
      "post": {
        "tags": [
          "Donations"
        ],
        "summary": "Confirm Donation Handover",
        "description": "Confirm physical handover of donation to neighbor, marking donation completed and recording impact activity.",
        "security": [
          {
            "ApiKeyAuth": []
          },
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Donation completed and food waste impact logged"
          }
        }
      }
    },
    "/api/v1/impact/summary": {
      "get": {
        "tags": [
          "Impact & Analytics"
        ],
        "summary": "Monthly Savings & Portions Summary",
        "description": "Get monthly aggregation of total food portions saved, estimated money saved, CO2 prevented, and home-cooking vs donation ratio.",
        "security": [
          {
            "ApiKeyAuth": []
          },
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "month",
            "in": "query",
            "schema": {
              "type": "integer"
            },
            "example": 11,
            "description": "Month (1-12)"
          },
          {
            "name": "year",
            "in": "query",
            "schema": {
              "type": "integer"
            },
            "example": 2026,
            "description": "Year (e.g. 2026)"
          }
        ],
        "responses": {
          "200": {
            "description": "Monthly impact summary and composition ratio"
          }
        }
      }
    },
    "/api/v1/impact/history": {
      "get": {
        "tags": [
          "Impact & Analytics"
        ],
        "summary": "Food Waste Reduction History",
        "description": "Get paginated activity history of cooked recipes and completed food donations.",
        "security": [
          {
            "ApiKeyAuth": []
          },
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer"
            },
            "example": 1,
            "description": "Page number"
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer"
            },
            "example": 10,
            "description": "Items per page"
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated impact activity history"
          }
        }
      }
    },
    "/api/v1/impact/history/{id}": {
      "get": {
        "tags": [
          "Impact & Analytics"
        ],
        "summary": "Get Impact Activity Detail",
        "description": "Retrieve detailed breakdown of ingredients, market prices, and CO2e emissions prevented for a specific activity.",
        "security": [
          {
            "ApiKeyAuth": []
          },
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Impact activity details and breakdown"
          }
        }
      }
    }
  }
}