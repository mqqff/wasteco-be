{
  "openapi": "3.1.0",
  "info": {
    "title": "WasteCo Backend API",
    "description": "RESTful API backend for WasteCo - Household Food Waste Prevention & Management System (PAPB Kelompok 1 TIF A 2026, Universitas Brawijaya). Every endpoint maps to specific Figma UI/UX prototype screens.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://wastecobe.mhqif.my.id",
      "description": "Production Server"
    },
    {
      "url": "http://127.0.0.1:8000",
      "description": "Local Development Server"
    }
  ],
  "components": {
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "x-api-key",
        "description": "Mandatory API key for all public and private requests (verified via SHA-256 in RequireAPIKey middleware)."
      },
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "JWT Bearer authentication token obtained from Login or Registration."
      }
    }
  },
  "security": [
    {
      "ApiKeyAuth": []
    }
  ],
  "paths": {
    "/api/v1/auth/register": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Register New User Account",
        "description": "Create a new user account with name, email, bcrypt-hashed password, neighborhood area, and WhatsApp phone number.\n\n**Figma Screen Reference**: Screen S03 (Daftar WasteCo / Registration Screen).",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "example": {
                "name": "Affan Maulana",
                "email": "affan@wasteco.id",
                "password": "password123",
                "phone_number": "+6281234567890",
                "area_name": "Dinoyo, Lowokwaru, Malang",
                "latitude": -7.9528,
                "longitude": 112.6074,
                "sharing_radius_km": 3
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "User account created successfully and JWT access token generated"
          }
        }
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "User Login",
        "description": "Authenticate an existing user with email and password, returning JWT access token and user profile with cumulative impact stats.\n\n**Figma Screen Reference**: Screen S02 (Masuk WasteCo / Login Screen).",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "example": {
                "email": "affan@wasteco.id",
                "password": "password123"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Authentication successful, returns JWT token and profile"
          }
        }
      }
    },
    "/api/v1/me": {
      "get": {
        "tags": [
          "User Profile"
        ],
        "summary": "Get Profile & Cumulative Contribution Stats",
        "description": "Retrieve current authenticated user's profile details, default neighborhood location coordinates, and overall cumulative contribution metrics (total portions saved).\n\n**Figma Screen Reference**: Screen S04 (Beranda WasteCo / Header Section) & Screen S17 (Profil / Profile Overview Screen).",
        "security": [
          {
            "ApiKeyAuth": []
          },
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Returns profile details and total portions saved"
          }
        }
      },
      "put": {
        "tags": [
          "User Profile"
        ],
        "summary": "Update Profile & Neighborhood Settings",
        "description": "Update user profile information such as display name, WhatsApp coordination phone number, neighborhood area, GPS coordinates, and donation sharing radius in km.\n\n**Figma Screen Reference**: Screen S17 (Profil & Pengaturan Area / Edit Profile Screen).",
        "security": [
          {
            "ApiKeyAuth": []
          },
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "example": {
                "name": "Affan Maulana",
                "phone_number": "+6281234567890",
                "area_name": "Dinoyo, Lowokwaru, Malang",
                "latitude": -7.9528,
                "longitude": 112.6074,
                "sharing_radius_km": 3
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Profile updated successfully"
          }
        }
      }
    },
    "/api/v1/pantry": {
      "get": {
        "tags": [
          "Pantry"
        ],
        "summary": "List Active Pantry Ingredients",
        "description": "Retrieve all active ingredients currently stored in the user's kitchen pantry (status 'fresh' or 'near_expiry'). Supports filtering by category and auto-calculates remaining days until expiry (days_until_expiry).\n\n**Figma Screen Reference**: Screen S04 (Beranda / Bahan Dapur Aktif) & Screen S05 (Pilih Bahan / Pantry Checklist Screen).",
        "security": [
          {
            "ApiKeyAuth": []
          },
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "category",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Filter by category (Bahan Pokok, Sayuran, Lauk / Protein, Buah, Bumbu)"
          },
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Filter by status: fresh, near_expiry"
          }
        ],
        "responses": {
          "200": {
            "description": "List of active pantry items with expiry calculations"
          }
        }
      },
      "post": {
        "tags": [
          "Pantry"
        ],
        "summary": "Add Pantry Ingredient",
        "description": "Add a new food item into the user's pantry inventory. `category`, `storage_location`, and `expiry_date` are optional. Status is automatically classified as 'near_expiry' if expiry date is within 3 days.\n\n**Figma Screen Reference**: Screen S05 (Input Bahan Sisa — manual form: name, quantity, unit).",
        "security": [
          {
            "ApiKeyAuth": []
          },
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "example": {
                "name": "Wortel",
                "quantity": 100,
                "unit": "gram"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Pantry ingredient created successfully"
          }
        }
      }
    },
    "/api/v1/pantry/bulk": {
      "post": {
        "tags": [
          "Pantry"
        ],
        "summary": "Bulk Add Pantry Ingredients",
        "description": "Add several pantry items in one call (1–50 items), typically the reviewed result of `POST /pantry/scan`. Each item follows the same rules as `POST /pantry`.\n\n**Figma Screen Reference**: Screen S05B (Cek Hasil Foto — \"Tambahkan 3 Bahan\") → S05C (toast \"3 bahan berhasil ditambahkan\").",
        "security": [
          {
            "ApiKeyAuth": []
          },
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "example": {
                "items": [
                  {
                    "name": "Bayam",
                    "quantity": 1,
                    "unit": "ikat"
                  },
                  {
                    "name": "Tomat",
                    "quantity": 2,
                    "unit": "buah"
                  },
                  {
                    "name": "Bawang Putih",
                    "quantity": 4,
                    "unit": "siung"
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Pantry ingredients created successfully. Payload: `ingredients` (array) and `total`."
          },
          "400": {
            "description": "Empty list, more than 50 items, or invalid item (`validation_error`)."
          }
        }
      }
    },
    "/api/v1/pantry/scan": {
      "post": {
        "tags": [
          "Pantry"
        ],
        "summary": "Detect Ingredients from Photo (Gemini Vision)",
        "description": "Upload a photo of leftover ingredients; Gemini AI detects each ingredient with an estimated quantity and unit. **Nothing is saved** — the client shows the result for review/editing, then saves it with `POST /pantry/bulk`.\n\nAccepted: JPEG, PNG, WebP (detected from file content), max 4 MB request body.\n\n**Figma Screen Reference**: Screen S05A (Foto Bahan Sisa) → S05B (Cek Hasil Foto).",
        "security": [
          {
            "ApiKeyAuth": []
          },
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "image"
                ],
                "properties": {
                  "image": {
                    "type": "string",
                    "format": "binary",
                    "description": "Photo of the ingredients"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Detected ingredients (may be an empty list).",
            "content": {
              "application/json": {
                "example": {
                  "payload": {
                    "ingredients": [
                      {
                        "name": "Bayam",
                        "quantity": 1,
                        "unit": "ikat"
                      },
                      {
                        "name": "Tomat",
                        "quantity": 2,
                        "unit": "buah"
                      },
                      {
                        "name": "Bawang Putih",
                        "quantity": 4,
                        "unit": "siung"
                      }
                    ],
                    "total": 3
                  }
                }
              }
            }
          },
          "400": {
            "description": "Missing `image` field or unsupported file type (`bad_request` / `validation_error`)."
          },
          "500": {
            "description": "Gemini failed or is temporarily overloaded (`internal_server_error`); safe to retry."
          }
        }
      }
    },
    "/api/v1/pantry/{id}": {
      "put": {
        "tags": [
          "Pantry"
        ],
        "summary": "Update Pantry Ingredient",
        "description": "Update item quantity, storage location, expiry date, or status (fresh, near_expiry, used, donated).\n\n**Figma Screen Reference**: Screen S04 / S05 (Edit Bahan Dapur / Edit Pantry Item Screen).",
        "security": [
          {
            "ApiKeyAuth": []
          },
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Pantry ingredient UUID"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "example": {
                "name": "Wortel Segar",
                "quantity": 200,
                "unit": "gram",
                "category": "Sayuran",
                "storage_location": "Kulkas bagian bawah",
                "expiry_date": "2026-11-15",
                "status": "near_expiry"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Pantry item updated successfully"
          }
        }
      },
      "delete": {
        "tags": [
          "Pantry"
        ],
        "summary": "Delete Pantry Ingredient",
        "description": "Permanently remove an ingredient from the user's pantry.\n\n**Figma Screen Reference**: Screen S05 (Hapus Bahan Dapur / Delete Pantry Item).",
        "security": [
          {
            "ApiKeyAuth": []
          },
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Pantry ingredient UUID"
          }
        ],
        "responses": {
          "200": {
            "description": "Pantry item deleted successfully"
          }
        }
      }
    },
    "/api/v1/recipes/generate": {
      "post": {
        "tags": [
          "Recipes & AI"
        ],
        "summary": "Generate Zero-Waste Recipes (Gemini AI)",
        "description": "Generate ranked Indonesian home-cooking recipes via Gemini AI. Supports **two input modes**:\n1. `application/json`: provide `ingredient_ids` / `custom_ingredients` (or empty body to use all active pantry items).\n2. `multipart/form-data`: upload an `image` (JPEG, PNG, WebP, max 4 MB) — Gemini performs visual detection & OCR on the image (ingredients, fridge contents, shopping receipts, labels) and immediately returns both `detected_ingredients` and ranked `recipes`.\n\n**Figma Screen Reference**: Screen S05 (Pilih Bahan & Cari Resep), Screen S05A (Foto Bahan), Screen S06 (Rekomendasi Resep AI), & Screen S07 (Detail Resep Masak).",
        "security": [
          {
            "ApiKeyAuth": []
          },
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "example": {
                "ingredient_ids": [
                  "258568e6-4c01-4968-bdaa-8db09af7c40b",
                  "fbc6bf3d-6155-4332-9e62-7ff1d2a36790"
                ],
                "custom_ingredients": [
                  "Bawang Merah & Putih"
                ]
              }
            },
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "image"
                ],
                "properties": {
                  "image": {
                    "type": "string",
                    "format": "binary",
                    "description": "Photo of ingredients, fridge items, or grocery receipt/labels for Gemini Vision + OCR"
                  },
                  "custom_ingredients": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "Optional extra ingredients to combine with OCR results"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "List of recommended zero-waste recipes ordered by highest match percentage"
          },
          "400": {
            "description": "`bad_request` or `validation_error` (invalid body or no active ingredients available)."
          },
          "500": {
            "description": "`recipe_generation_error` (Gemini AI generation failed)."
          }
        }
      }
    },
    "/api/v1/recipes/cook-confirm": {
      "post": {
        "tags": [
          "Recipes & AI"
        ],
        "summary": "Confirm Cooking & Auto-Deduct Pantry",
        "description": "Confirms recipe preparation completion. Automatically subtracts used ingredient quantities from the pantry (or updates status to 'used' if fully depleted), and automatically logs the food rescue activity into the impact ledger with portions saved and CO2e prevented.\n\n**Figma Screen Reference**: Screen S08 (Konfirmasi Selesai Memasak / Cooking Confirmation Screen).",
        "security": [
          {
            "ApiKeyAuth": []
          },
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "example": {
                "recipe_name": "Nasi Goreng Wortel Telur",
                "portions": 2,
                "used_ingredients": [
                  {
                    "ingredient_id": "fbc6bf3d-6155-4332-9e62-7ff1d2a36790",
                    "name": "Nasi Putih",
                    "quantity": 2,
                    "unit": "porsi"
                  },
                  {
                    "name": "Telur Ayam",
                    "quantity": 2,
                    "unit": "butir"
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Pantry items deducted and cooking impact recorded successfully"
          }
        }
      }
    },
    "/api/v1/donations": {
      "get": {
        "tags": [
          "Donations"
        ],
        "summary": "List Nearby Donation Requests",
        "description": "Open, non-expired requests from other users, sorted by distance (Haversine). `lat`/`long` default to the caller's profile coordinates and `radius` (km) to the profile `sharing_radius_km`. Contacts are omitted in lists.\n\n**Flow**: requester creates a request (`open`) → one donor fulfils selected items (`handed_over`) → requester confirms receipt (`received`, donor's impact is logged). Requester may cancel while `open` or `handed_over`. Coordination happens via WhatsApp (`whatsapp_url`).\n\n**Figma Screen Reference**: S09 (Donation Hub — Sekitar Saya), S10 (Peta Permintaan), S04 (Permintaan di Sekitarmu).",
        "security": [
          {
            "ApiKeyAuth": []
          },
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "lat",
            "in": "query",
            "schema": {
              "type": "number"
            },
            "description": "Viewer latitude (optional)"
          },
          {
            "name": "long",
            "in": "query",
            "schema": {
              "type": "number"
            },
            "description": "Viewer longitude (optional)"
          },
          {
            "name": "radius",
            "in": "query",
            "schema": {
              "type": "number"
            },
            "description": "Radius in km (optional)"
          },
          {
            "name": "search",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Matches request title or item names"
          }
        ],
        "responses": {
          "200": {
            "description": "Nearby open requests",
            "content": {
              "application/json": {
                "example": {
                  "payload": {
                    "donations": [
                      {
                        "id": "b3f1c7d2-8e4a-4c6b-9f2d-1a7e5c3b9d40",
                        "title": "Wortel & Telur",
                        "note": "Untuk masak makan malam keluarga. Bantu sebagian item juga boleh.",
                        "area_name": "Dinoyo, Malang",
                        "meeting_point": "Depan Minimarket Dinoyo",
                        "latitude": -7.9535,
                        "longitude": 112.608,
                        "receive_start": "2026-11-17T16:00:00+07:00",
                        "receive_end": "2026-11-17T19:00:00+07:00",
                        "status": "open",
                        "item_count": 3,
                        "items": [
                          {
                            "id": "6f1c2a9e-3b0d-4f7a-9a51-2d9b8c7e4f10",
                            "name": "Wortel",
                            "quantity": 500,
                            "unit": "gram",
                            "selected": false
                          },
                          {
                            "id": "0c9e4d21-7b3a-4e8f-a6c5-3d2b1f0e9a87",
                            "name": "Telur Ayam",
                            "quantity": 4,
                            "unit": "butir",
                            "selected": false
                          },
                          {
                            "id": "7a2b8c3d-1e4f-4a5b-9c6d-8e7f6a5b4c32",
                            "name": "Nasi Putih",
                            "quantity": 2,
                            "unit": "porsi",
                            "selected": false
                          }
                        ],
                        "distance_km": 0.8,
                        "formatted_distance": "800 m",
                        "created_at": "2026-11-17T15:00:00+07:00",
                        "requester": {
                          "id": "a3946688-91fe-4dda-a899-f7204db5a012",
                          "name": "Budi Santoso",
                          "area_name": "Dinoyo, Malang"
                        }
                      }
                    ],
                    "total": 1
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Donations"
        ],
        "summary": "Create Donation Request",
        "description": "Ask neighbours for ingredients. `title` is optional (defaults to the first two item names joined by \" & \"), `area_name` defaults to the profile area. `receive_end` must be after `receive_start` and in the future. The requester must have a WhatsApp number (`phone_number`) in their profile.\n\n**Flow**: requester creates a request (`open`) → one donor fulfils selected items (`handed_over`) → requester confirms receipt (`received`, donor's impact is logged). Requester may cancel while `open` or `handed_over`. Coordination happens via WhatsApp (`whatsapp_url`).\n\n**Figma Screen Reference**: S12 (Buat Permintaan).",
        "security": [
          {
            "ApiKeyAuth": []
          },
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "example": {
                "title": "Wortel & Telur",
                "note": "Untuk masak makan malam keluarga. Bantu sebagian item juga boleh.",
                "items": [
                  {
                    "name": "Wortel",
                    "quantity": 500,
                    "unit": "gram"
                  },
                  {
                    "name": "Telur Ayam",
                    "quantity": 4,
                    "unit": "butir"
                  },
                  {
                    "name": "Nasi Putih",
                    "quantity": 2,
                    "unit": "porsi"
                  }
                ],
                "area_name": "Dinoyo, Malang",
                "meeting_point": "Depan Minimarket Dinoyo",
                "latitude": -7.9535,
                "longitude": 112.608,
                "receive_start": "2026-11-17T16:00:00+07:00",
                "receive_end": "2026-11-17T19:00:00+07:00"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Donation request created",
            "content": {
              "application/json": {
                "example": {
                  "payload": {
                    "donation": {
                      "id": "b3f1c7d2-8e4a-4c6b-9f2d-1a7e5c3b9d40",
                      "title": "Wortel & Telur",
                      "note": "Untuk masak makan malam keluarga. Bantu sebagian item juga boleh.",
                      "area_name": "Dinoyo, Malang",
                      "meeting_point": "Depan Minimarket Dinoyo",
                      "latitude": -7.9535,
                      "longitude": 112.608,
                      "receive_start": "2026-11-17T16:00:00+07:00",
                      "receive_end": "2026-11-17T19:00:00+07:00",
                      "status": "open",
                      "item_count": 3,
                      "items": [
                        {
                          "id": "6f1c2a9e-3b0d-4f7a-9a51-2d9b8c7e4f10",
                          "name": "Wortel",
                          "quantity": 500,
                          "unit": "gram",
                          "selected": false
                        },
                        {
                          "id": "0c9e4d21-7b3a-4e8f-a6c5-3d2b1f0e9a87",
                          "name": "Telur Ayam",
                          "quantity": 4,
                          "unit": "butir",
                          "selected": false
                        },
                        {
                          "id": "7a2b8c3d-1e4f-4a5b-9c6d-8e7f6a5b4c32",
                          "name": "Nasi Putih",
                          "quantity": 2,
                          "unit": "porsi",
                          "selected": false
                        }
                      ],
                      "requester": {
                        "id": "a3946688-91fe-4dda-a899-f7204db5a012",
                        "name": "Budi Santoso",
                        "area_name": "Dinoyo, Malang",
                        "whatsapp_number": "+6281358902144",
                        "whatsapp_url": "https://wa.me/6281358902144"
                      },
                      "distance_km": 0.8,
                      "formatted_distance": "800 m",
                      "created_at": "2026-11-17T15:00:00+07:00"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "`validation_error`, `bad_request`, or `phone_number_required` (user has no WhatsApp number in profile)."
          }
        }
      }
    },
    "/api/v1/donations/my": {
      "get": {
        "tags": [
          "Donations"
        ],
        "summary": "My Donation Requests",
        "description": "Donations involving the caller. Defaults to `role=requester` (requests created by the caller); pass `role=donor` for donations fulfilled by the caller or `role=all` for both. `active` = `open` / `handed_over`, `history` = `received` / `cancelled`. Includes requester & donor info and WhatsApp link.\n\n**Figma Screen Reference**: S13 (Permintaan Saya — status Dibuat → Diserahkan → Diterima).",
        "security": [
          {
            "ApiKeyAuth": []
          },
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "role",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "requester",
                "donor",
                "all"
              ]
            },
