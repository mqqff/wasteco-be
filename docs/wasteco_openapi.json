{
  "openapi": "3.1.0",
  "info": {
    "title": "WasteCo Backend API",
    "description": "RESTful API backend for WasteCo - Household Food Waste Prevention & Management System (PAPB Kelompok 1 TIF A 2026, Universitas Brawijaya). Every endpoint maps to specific Figma UI/UX prototype screens.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8000",
      "description": "Local Development Server"
    }
  ],
  "components": {
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "x-api-key",
        "description": "Mandatory API key for all public and private requests (verified via SHA-256 in RequireAPIKey middleware)."
      },
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "JWT Bearer authentication token obtained from Login or Registration."
      }
    }
  },
  "security": [
    {
      "ApiKeyAuth": []
    }
  ],
  "paths": {
    "/api/v1/auth/register": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Register New User Account",
        "description": "Create a new user account with name, email, bcrypt-hashed password, neighborhood area, and WhatsApp phone number.\n\n**Figma Screen Reference**: Screen S03 (Daftar WasteCo / Registration Screen).",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "example": {
                "name": "Affan Maulana",
                "email": "affan@wasteco.id",
                "password": "password123",
                "phone_number": "+6281234567890",
                "area_name": "Dinoyo, Lowokwaru, Malang",
                "latitude": -7.9528,
                "longitude": 112.6074,
                "sharing_radius_km": 3
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "User account created successfully and JWT access token generated"
          }
        }
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "User Login",
        "description": "Authenticate an existing user with email and password, returning JWT access token and user profile with cumulative impact stats.\n\n**Figma Screen Reference**: Screen S02 (Masuk WasteCo / Login Screen).",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "example": {
                "email": "affan@wasteco.id",
                "password": "password123"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Authentication successful, returns JWT token and profile"
          }
        }
      }
    },
    "/api/v1/me": {
      "get": {
        "tags": [
          "User Profile"
        ],
        "summary": "Get Profile & Cumulative Contribution Stats",
        "description": "Retrieve current authenticated user's profile details, default neighborhood location coordinates, and overall cumulative contribution metrics (total portions saved & total money saved).\n\n**Figma Screen Reference**: Screen S04 (Beranda WasteCo / Header Section) & Screen S17 (Profil / Profile Overview Screen).",
        "security": [
          {
            "ApiKeyAuth": []
          },
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Returns profile details and cumulative savings"
          }
        }
      },
      "put": {
        "tags": [
          "User Profile"
        ],
        "summary": "Update Profile & Neighborhood Settings",
        "description": "Update user profile information such as display name, WhatsApp coordination phone number, neighborhood area, GPS coordinates, and donation sharing radius in km.\n\n**Figma Screen Reference**: Screen S17 (Profil & Pengaturan Area / Edit Profile Screen).",
        "security": [
          {
            "ApiKeyAuth": []
          },
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "example": {
                "name": "Affan Maulana",
                "phone_number": "+6281234567890",
                "area_name": "Dinoyo, Lowokwaru, Malang",
                "latitude": -7.9528,
                "longitude": 112.6074,
                "sharing_radius_km": 3
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Profile updated successfully"
          }
        }
      }
    },
    "/api/v1/pantry": {
      "get": {
        "tags": [
          "Pantry"
        ],
        "summary": "List Active Pantry Ingredients",
        "description": "Retrieve all active ingredients currently stored in the user's kitchen pantry (status 'fresh' or 'near_expiry'). Supports filtering by category and auto-calculates remaining days until expiry (days_until_expiry).\n\n**Figma Screen Reference**: Screen S04 (Beranda / Bahan Dapur Aktif) & Screen S05 (Pilih Bahan / Pantry Checklist Screen).",
        "security": [
          {
            "ApiKeyAuth": []
          },
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "category",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Filter by category (Bahan Pokok, Sayuran, Lauk / Protein, Buah, Bumbu)"
          },
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Filter by status: fresh, near_expiry"
          }
        ],
        "responses": {
          "200": {
            "description": "List of active pantry items with expiry calculations"
          }
        }
      },
      "post": {
        "tags": [
          "Pantry"
        ],
        "summary": "Add Pantry Ingredient",
        "description": "Add a new food item into the user's pantry inventory. Status is automatically classified as 'near_expiry' if expiry date is within 3 days.\n\n**Figma Screen Reference**: Screen S05 (Input Bahan Cepat / Quick Add Ingredient Modal).",
        "security": [
          {
            "ApiKeyAuth": []
          },
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "example": {
                "name": "Wortel Segar",
                "quantity": 250,
                "unit": "gram",
                "category": "Sayuran",
                "storage_location": "Kulkas bagian bawah",
                "expiry_date": "2026-11-15",
                "estimated_price": 5000
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Pantry ingredient created successfully"
          }
        }
      }
    },
    "/api/v1/pantry/{id}": {
      "put": {
        "tags": [
          "Pantry"
        ],
        "summary": "Update Pantry Ingredient",
        "description": "Update item quantity, storage location, expiry date, estimated price, or status (fresh, near_expiry, used, donated).\n\n**Figma Screen Reference**: Screen S04 / S05 (Edit Bahan Dapur / Edit Pantry Item Screen).",
        "security": [
          {
            "ApiKeyAuth": []
          },
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Pantry ingredient UUID"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "example": {
                "name": "Wortel Segar",
                "quantity": 200,
                "unit": "gram",
                "category": "Sayuran",
                "storage_location": "Kulkas bagian bawah",
                "expiry_date": "2026-11-15",
                "status": "near_expiry",
                "estimated_price": 4000
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Pantry item updated successfully"
          }
        }
      },
      "delete": {
        "tags": [
          "Pantry"
        ],
        "summary": "Delete Pantry Ingredient",
        "description": "Permanently remove an ingredient from the user's pantry.\n\n**Figma Screen Reference**: Screen S05 (Hapus Bahan Dapur / Delete Pantry Item).",
        "security": [
          {
            "ApiKeyAuth": []
          },
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Pantry ingredient UUID"
          }
        ],
        "responses": {
          "200": {
            "description": "Pantry item deleted successfully"
          }
        }
      }
    },
    "/api/v1/recipes/generate": {
      "post": {
        "tags": [
          "Recipes & AI"
        ],
        "summary": "Generate Zero-Waste Recipes (Gemini AI)",
        "description": "Send selected pantry ingredient IDs or custom ingredient names to the Gemini AI engine (gemini-flash-lite-latest). Gemini returns ranked Indonesian home-cooking recipes with match percentages, cooking time, portions, estimated savings (Rp), available ingredients, additional ingredients, step-by-step instructions, and smart kitchen tips.\n\n**Figma Screen Reference**: Screen S05 (Pilih Bahan & Cari Resep), Screen S06 (Rekomendasi Resep AI), & Screen S07 (Detail Resep Masak).",
        "security": [
          {
            "ApiKeyAuth": []
          },
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "example": {
                "ingredient_ids": [
                  "258568e6-4c01-4968-bdaa-8db09af7c40b",
                  "fbc6bf3d-6155-4332-9e62-7ff1d2a36790"
                ],
                "custom_ingredients": [
                  "Bawang Merah & Putih"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "List of recommended zero-waste recipes ordered by highest match percentage"
          }
        }
      }
    },
    "/api/v1/recipes/cook-confirm": {
      "post": {
        "tags": [
          "Recipes & AI"
        ],
        "summary": "Confirm Cooking & Auto-Deduct Pantry",
        "description": "Confirms recipe preparation completion. Automatically subtracts used ingredient quantities from the pantry (or updates status to 'used' if fully depleted), and automatically logs the food rescue activity into the impact ledger with portions saved, estimated cost savings, and CO2e prevented.\n\n**Figma Screen Reference**: Screen S08 (Konfirmasi Selesai Memasak / Cooking Confirmation Screen).",
        "security": [
          {
            "ApiKeyAuth": []
          },
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "example": {
                "recipe_name": "Nasi Goreng Kampung Spesial Wortel Telur",
                "portions": 2,
                "estimated_savings": 25000,
                "used_ingredients": [
                  {
                    "ingredient_id": "fbc6bf3d-6155-4332-9e62-7ff1d2a36790",
                    "name": "Nasi Putih",
                    "quantity": 1,
                    "unit": "porsi",
                    "estimated_price": 5000
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Pantry items deducted and cooking impact recorded successfully"
          }
        }
      }
    },
    "/api/v1/donations": {
      "get": {
        "tags": [
          "Donations"
        ],
        "summary": "Explore Nearby Food Donations (Haversine)",
        "description": "Explore available surplus food donations posted by neighbors. Calculates real-time distance using the Haversine formula based on user coordinates (lat/long) and formats distance (e.g. '511 m', '1.8 km'). Supports filtering by category, radius in km, and search keywords.\n\n**Figma Screen Reference**: Screen S09 (Hub Berbagi / Sharing Hub List) & Screen S10 (Peta Berbagi / Geolocation Map Screen).",
        "parameters": [
          {
            "name": "lat",
            "in": "query",
            "schema": {
              "type": "number"
            },
            "example": -7.9535,
            "description": "User GPS latitude"
          },
          {
            "name": "long",
            "in": "query",
            "schema": {
              "type": "number"
            },
            "example": 112.608,
            "description": "User GPS longitude"
          },
          {
            "name": "radius",
            "in": "query",
            "schema": {
              "type": "number"
            },
            "example": 5,
            "description": "Search radius in km (default 5 km)"
          },
          {
            "name": "category",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "example": "Sayuran",
            "description": "Filter by category"
          },
          {
            "name": "search",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "example": "kentang",
            "description": "Search keyword for title or notes"
          }
        ],
        "responses": {
          "200": {
            "description": "List of available food donations with distance and donor summary"
          }
        }
      },
      "post": {
        "tags": [
          "Donations"
        ],
        "summary": "Post Food Donation (Multipart)",
        "description": "Publish a new surplus food donation for neighbors. Supports uploading up to 3 food photos to Supabase Storage, condition notes, storage method, pickup deadline, meeting point location, coordinates, and WhatsApp coordination number.\n\n**Figma Screen Reference**: Screen S12 (Buat Donasi / Create Food Donation Screen).",
        "security": [
          {
            "ApiKeyAuth": []
          },
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string",
                    "example": "Wortel Segar Kebun"
                  },
                  "category": {
                    "type": "string",
                    "example": "Sayuran"
                  },
                  "quantity": {
                    "type": "number",
                    "example": 500
                  },
                  "unit": {
                    "type": "string",
                    "example": "gram"
                  },
                  "condition_note": {
                    "type": "string",
                    "example": "Sudah dicuci bersih, kulit masih renyah dan tidak lembek."
                  },
                  "storage_method": {
                    "type": "string",
                    "example": "Chiller kulkas wadah tertutup"
                  },
                  "pickup_deadline": {
                    "type": "string",
                    "example": "2026-11-13T18:00:00Z"
                  },
                  "area_name": {
                    "type": "string",
                    "example": "Dinoyo, Malang"
                  },
                  "meeting_point": {
                    "type": "string",
                    "example": "Depan minimarket Alfamart MT Haryono"
                  },
                  "latitude": {
                    "type": "number",
                    "example": -7.9535
                  },
                  "longitude": {
                    "type": "number",
                    "example": 112.608
                  },
                  "whatsapp_number": {
                    "type": "string",
                    "example": "+6281358902144"
                  },
                  "estimated_price": {
                    "type": "number",
                    "example": 10000
                  },
                  "estimated_portions": {
                    "type": "integer",
                    "example": 2
                  },
                  "photos": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "format": "binary"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Food donation published successfully"
          }
        }
      }
    },
    "/api/v1/donations/my": {
      "get": {
        "tags": [
          "Donations"
        ],
        "summary": "Get My Posted Donations",
        "description": "Retrieve food donations posted by the authenticated user, organized into active ('available', 'in_progress') and history ('completed', 'cancelled') tabs.\n\n**Figma Screen Reference**: Screen S13 (Donasi Saya / My Donations Management Screen).",
        "security": [
          {
            "ApiKeyAuth": []
          },
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "List of user's active and past donations"
          }
        }
      }
    },
    "/api/v1/donations/{id}": {
      "get": {
        "tags": [
          "Donations"
        ],
        "summary": "Get Donation Detail & Donor Contact",
        "description": "Retrieve comprehensive details of a food donation, image photo URLs, food condition guide, pickup deadline, meeting point address, donor profile, and WhatsApp coordination number.\n\n**Figma Screen Reference**: Screen S11 (Detail Donasi) & Screen S11A (Dialog Lanjut ke WhatsApp).",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Donation UUID"
          },
          {
            "name": "lat",
            "in": "query",
            "schema": {
              "type": "number"
            },
            "description": "Optional user latitude for distance"
          },
          {
            "name": "long",
            "in": "query",
            "schema": {
              "type": "number"
            },
            "description": "Optional user longitude for distance"
          }
        ],
        "responses": {
          "200": {
            "description": "Detailed donation information and donor contact"
          }
        }
      },
      "delete": {
        "tags": [
          "Donations"
        ],
        "summary": "Cancel Donation",
        "description": "Cancel an active food donation post (updates status to 'cancelled'). Only allowed by the donor owner.\n\n**Figma Screen Reference**: Screen S13 (Batalkan Donasi / Cancel Donation Action).",
        "security": [
          {
            "ApiKeyAuth": []
          },
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Donation UUID"
          }
        ],
        "responses": {
          "200": {
            "description": "Donation cancelled successfully"
          }
        }
      }
    },
    "/api/v1/donations/{id}/status": {
      "patch": {
        "tags": [
          "Donations"
        ],
        "summary": "Update Donation Status",
        "description": "Update the operational status of a donation post (e.g., mark as 'in_progress' when a neighbor contacts via WhatsApp).\n\n**Figma Screen Reference**: Screen S13 (Ubah Status Donasi / Update Status).",
        "security": [
          {
            "ApiKeyAuth": []
          },
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Donation UUID"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "example": {
                "status": "in_progress"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Donation status updated"
          }
        }
      }
    },
    "/api/v1/donations/{id}/confirm-handed": {
      "post": {
        "tags": [
          "Donations"
        ],
        "summary": "Confirm Donation Handover (Record Impact)",
        "description": "Confirm the physical handover of food to a recipient. Marks donation status as 'completed', removes it from public discovery, and automatically logs the food rescue activity into the impact ledger with portions saved, estimated food value (Rp), and CO2e prevented.\n\n**Figma Screen Reference**: Screen S13 & Screen S14 (Konfirmasi Berhasil Dibagikan / Handover Confirmation Screen).",
        "security": [
          {
            "ApiKeyAuth": []
          },
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Donation UUID"
          }
        ],
        "responses": {
          "200": {
            "description": "Donation marked completed and impact activity recorded successfully"
          }
        }
      }
    },
    "/api/v1/impact/summary": {
      "get": {
        "tags": [
          "Impact & Analytics"
        ],
        "summary": "Monthly Savings & Portions Summary",
        "description": "Retrieve monthly aggregated metrics: total portions saved, total estimated money saved (Rp), total CO2e prevented (kg), composition breakdown (portions, savings, and percentage for Home-Cooked vs Donated-to-Neighbors), and top 3 recent activities.\n\n**Figma Screen Reference**: Screen S04 (Beranda / Dampak Bulan Ini), Screen S15 (Layar Dampak / Impact Dashboard Screen), & Screen S15B (Dampak Setelah Berbagi Toast).",
        "security": [
          {
            "ApiKeyAuth": []
          },
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "month",
            "in": "query",
            "schema": {
              "type": "integer"
            },
            "example": 11,
            "description": "Month number (1-12)"
          },
          {
            "name": "year",
            "in": "query",
            "schema": {
              "type": "integer"
            },
            "example": 2026,
            "description": "Year (e.g. 2026)"
          }
        ],
        "responses": {
          "200": {
            "description": "Monthly impact summary and composition statistics"
          }
        }
      }
    },
    "/api/v1/impact/history": {
      "get": {
        "tags": [
          "Impact & Analytics"
        ],
        "summary": "Food Waste Reduction Activity Log",
        "description": "Paginated activity history of all saved food actions (both cooked recipes and completed food donations) with relative formatting (e.g. 'Just now', '42 minutes ago', 'Today, 06:15').\n\n**Figma Screen Reference**: Screen S15 (Riwayat Aktivitas Penyelamatan Makanan / Impact History List Screen).",
        "security": [
          {
            "ApiKeyAuth": []
          },
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer"
            },
            "example": 1,
            "description": "Page number (defaults to 1)"
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer"
            },
            "example": 10,
            "description": "Items per page (defaults to 10)"
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated impact activity history"
          }
        }
      }
    },
    "/api/v1/impact/history/{id}": {
      "get": {
        "tags": [
          "Impact & Analytics"
        ],
        "summary": "Get Impact Activity Detail Breakdown",
        "description": "Retrieve complete details for a specific food rescue activity: individual item breakdown, consumed quantities, estimated market prices, and CO2e emission reductions.\n\n**Figma Screen Reference**: Screen S16 (Detail Riwayat Dampak / Impact Breakdown Screen).",
        "security": [
          {
            "ApiKeyAuth": []
          },
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Impact activity UUID"
          }
        ],
        "responses": {
          "200": {
            "description": "Detailed impact activity with itemized breakdown"
          }
        }
      }
    }
  }
}